# MongoDB connection string (Atlas or self-hosted). Required.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/highgrade?retryWrites=true&w=majority

# Public site URL, used for canonical URLs, sitemap, Open Graph and origin checks.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: extra comma-separated origins allowed to call admin APIs (e.g. a Vercel preview URL).
ALLOWED_ORIGINS=

# Initial admin (used ONLY by `npm run create-admin`; never read by the running app).
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Darius Williams

# Optional: email alerts for new bookings and quote requests.
# Option A - Gmail: SMTP_USER = the Gmail address, SMTP_PASS = a Google App Password (myaccount.google.com/apppasswords).
SMTP_USER=
SMTP_PASS=
# Option B - Resend (https://resend.com):
# Leave blank to disable; submissions are always saved and shown in the admin panel.
RESEND_API_KEY=
# Sender address on a domain verified in Resend, e.g. "Highgrade Website <bookings@yourdomain.com>".
NOTIFY_EMAIL_FROM=
# Comma-separated recipients. Defaults to the email in Admin -> Settings when blank.
NOTIFY_EMAIL_TO=
